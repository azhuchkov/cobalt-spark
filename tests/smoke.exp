# Usage: expect tests/smoke.exp command ?arg ...?
set timeout 90
if {$argc == 0} {
    puts stderr "Usage: expect tests/smoke.exp command ?arg ...?"
    exit 1
}

spawn {*}$argv

expect {
    -exact "⚡" {}
    timeout { exit 1 }
    eof { exit 1 }
}

send -- "exit\r"

expect {
    eof {}
    timeout { exit 1 }
}

set result [wait]
if {[lindex $result 2] != 0 || [llength $result] > 4} {
    exit 1
}
exit [lindex $result 3]
