# Usage: expect tests/smoke.exp command ?arg ...?
set timeout 90
if {$argc == 0} {
    puts stderr "Usage: expect tests/smoke.exp command ?arg ...?"
    exit 1
}

set non_tty [catch {exec sh -c {test -t 1} >@stdout}]

if {$non_tty} {
  puts stderr "NOTE: Non-terminal output. Zsh terminal control sequences (e.g. 2004h/2004l) may appear as text."
}

spawn {*}$argv

expect {
    -exact "⚡" {}
    timeout {
        puts stderr "Timed out waiting for the Cobalt Spark prompt"
        exit 1
    }
    eof {
        puts stderr "Shell exited before displaying the Cobalt Spark prompt"
        exit 1
    }
}

send -- "exit\r"

expect {
    eof {}
    timeout {
        puts stderr "Timed out waiting for the shell to exit"
        exit 1
    }
}

set result [wait]
if {[lindex $result 2] != 0 || [llength $result] > 4} {
    puts stderr "Shell did not exit normally: $result"
    exit 1
}
if {[lindex $result 3] != 0} {
    puts stderr "Shell exited with status [lindex $result 3]"
}
exit [lindex $result 3]
